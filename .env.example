# Copiar a .env.local y completar. No commitear valores reales.

# --- Tuya Cloud ---
# Credenciales del proyecto en Tuya Cloud, compartidas por todos los
# medidores. El device id de cada medidor NO va acá: se vincula a una cuenta
# en la tabla `meters` (ver supabase/migrations/0004_meters.sql).
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_BASE_URL=https://openapi.tuyaus.com

# --- Supabase (servidor) ---
# La service role key es secreta y solo se usa en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (público) ---
# Se usan para el login del navegador. La clave anónima está diseñada para
# exponerse: el control de acceso real lo hacen las políticas RLS.
# Panel de Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Recolector programado ---
# Secreto compartido entre la función programada de Netlify y
# /api/meter/collect. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COLLECTOR_SECRET=

# --- Alertas por email (opcional) ---
# Sin estas variables la app funciona igual: las anomalías se detectan y
# quedan registradas, solo que no se envía el aviso.
# API key en https://resend.com -> API Keys
RESEND_API_KEY=
# Remitente. Con el dominio de prueba de Resend (sin verificar uno propio)
# tiene que ser "onboarding@resend.dev", y solo puede entregar al email con el
# que se registró la cuenta de Resend — por eso ALERT_EMAIL_TO usa esa misma
# casilla.
ALERT_EMAIL_FROM=
# Casilla única que recibe todos los avisos, la revisen quienes la revisen.
ALERT_EMAIL_TO=

# --- Frontend ---
# Base del link "Ver el detalle" de los mails de alerta. Este repo es solo
# backend: no tiene pantallas, así que el link tiene que apuntar al sitio del
# frontend. Si no se define, se usa la URL del propio sitio (variable `URL`,
# que define Netlify), igual que antes de separar los repos.
FRONTEND_URL=
